# Django Production / Development Settings
# Generate a strong secret key in production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-strong-50-char-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# HTTPS Production Settings (applied automatically when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Database Configuration
# Option A (Production PostgreSQL - Neon / Render / Supabase):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL_REQUIRE=True
#
# Option B (Local SQLite default or MySQL):
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=pinacle_fashions
# DB_USER=pinacle_app_user
# DB_PASSWORD=strong_database_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Persistent Media Storage (Cloudinary Free Tier - required on Render Free ephemeral filesystem)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Optional One-Time Initial Superuser Bootstrap (used safely by build.sh on empty DB)
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_EMAIL=pinaclefashions@gmail.com
# DJANGO_ADMIN_PASSWORD=replace-with-strong-admin-password

# WhatsApp & Brand Details
WHATSAPP_NUMBER=916238006820
BRAND_NAME=PINACLE FASHIONS
